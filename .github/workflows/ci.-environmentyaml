concurrency:
  group: my-ci-workflow-${{ github.ref_name }}.

jobs:
   get-environment:
    name: Get Environment name
    runs-on: ubuntu-latest
    outputs:
      name: ${{ steps.get-environment-name.outputs.environment }}
    steps:
      - name:  Get environment name
        id: get-environment-name
        run: |
          if [[ "${{ github.event_name }}" == "pull_request" ]]; then
            echo "environment=${{ github.base_ref }}" >> $GITHUB_OUTPUT
          else
            echo "environment=${{ github.ref_name }}" >> $GITHUB_OUTPUT
          fi

      

